{
  "name": "@examguard/desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "files": [
    "out"
  ],
  "scripts": {
    "build:site-reader": "node scripts/build-site-reader.mjs",
    "dev:teacher": "electron-vite dev --mode teacher -- --profile teacher",
    "dev:student": "node scripts/build-site-reader.mjs && electron-vite dev --mode student -- --profile student",
    "build": "pnpm run build:teacher && pnpm run build:student",
    "build:teacher": "electron-vite build --mode teacher",
    "build:student": "node scripts/build-site-reader.mjs && electron-vite build --mode student",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
