{
  "name": "@examguard/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:teacher": "electron-vite dev -- --profile teacher",
    "dev:student": "cross-env EG_FAKE_AGENT=1 electron-vite dev -- --profile student",
