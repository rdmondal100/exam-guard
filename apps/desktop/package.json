{
  "name": "@examguard/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build:server": "pnpm --filter @examguard/server build",
    "dev": "pnpm build:server && electron-vite dev",
    "dev:teacher": "pnpm build:server && electron-vite dev -- --profile teacher",
    "dev:student": "pnpm build:server && cross-env EG_FAKE_AGENT=1 electron-vite dev -- --profile student",
    "dev:student:agent": "cargo build -p eg-agent --release && pnpm build:server && electron-vite dev -- --profile student",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@examguard/server": "workspace:*",
    "@examguard/shared": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-table": "^8.21.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.0.0",
    "bonjour-service": "^1.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "monaco-editor": "^0.57.0",
    "node-pty": "1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-vite": "^6.0.0",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "ws": "^8"
  }
}
