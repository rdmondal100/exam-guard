{
  "name": "examguard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:teacher": "pnpm --filter @examguard/desktop dev:teacher",
    "dev:student": "pnpm --filter @examguard/desktop dev:student",
    "dev:student:agent": "pnpm --filter @examguard/desktop dev:student:agent",
    "sim": "pnpm --filter @examguard/student-sim sim",
    "fetch-toolchains": "node scripts/fetch-toolchains.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
